# Public browser RPC URL (never put a private API key in a VITE_ variable)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional server-only RPC endpoint for Solana Actions
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional production origin; Vercel supplies the deployment origin automatically
# SITE_ORIGIN=https://your-project.vercel.app
